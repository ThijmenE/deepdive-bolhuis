        <engine:Label text="Uitleg&#10;&#10;Het doel van het spel is dat&#10;je kerstbomen moet planten&#10;en verkopen.&#10;&#10;je hebt upgrades die je gaan&#10;helpen met het verzamelen&#10;van score." name="Uitleg" style="font-size: 50px; top: 30%; left: auto; background-image: url(&quot;project://database/Assets/Thijmen/UI/UI%20buttons/Sliced%20PNG%C2%B4s/BigGreenButton.png?fileID=2800000&amp;guid=9ab8dda5caef68e4eb6a9e6d3bdd4580&amp;type=3#BigGreenButton&quot;); height: 542px; width: 699px; -unity-text-align: middle-center; justify-content: flex-start; position: absolute; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/Thijmen/UI/Font/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;);" />
